# Copy to .env.local and fill in.

# Required. Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client (Google Cloud console > APIs & Services > Credentials > OAuth client ID, Web application).
# Authorized redirect URI: <your app URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: only accept accounts from this Google Workspace domain.
GOOGLE_WORKSPACE_DOMAIN=

# Comma-separated emails that may always sign in as Admin, even if not in the users tab yet.
BOOTSTRAP_ADMIN_EMAILS=

# Demo login: sign in as any user from the users tab without Google. Never enable in production.
AUTH_DEV_LOGIN=false

# Where the input tabs (one CSV per tab) are loaded from when the database is empty. Defaults to data/sample (DUMMY data).
SEED_DIR=
# SQLite file. Defaults to data/tracker.db.
DATABASE_PATH=
# Pin "today" (YYYY-MM-DD) for demos on the dummy data. Leave empty in production.
TRACKER_TODAY=
